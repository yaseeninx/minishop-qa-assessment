{
  "name": "minishop-mock-server",
  "version": "1.0.0",
  "private": true,
  "description": "Local mock of the MiniShop API (serves the collection's saved examples) + Newman runner",
  "scripts": {
    "mock": "node server.js",
    "test": "node run-tests.js",
