									"});",
									"",
									"pm.test('Status is 409 Conflict', function () {",
									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test('Error body has a non-empty string \"error\" field', function () {",
									"    pm.expect(body).to.have.property('error');",
									"    pm.expect(body.error).to.be.a('string').that.is.not.empty;",
									"});",
									"",
									"pm.test('Error message names the out-of-stock product', function () {",
									"    pm.expect(body.error).to.equal(product.name + ' is currently out of stock');",
									"});",
