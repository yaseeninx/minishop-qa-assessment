				{
					"name": "GET /orders/{orderId} - existing order (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"const requestedId = pm.request.url.path[pm.request.url.path.length - 1];",
									"const catalogue = JSON.parse(pm.collectionVariables.get('expectedCatalogue'));",
									"const created = pm.collectionVariables.get('createdOrder');",
									"",
									"pm.test('Status is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Required fields present: orderId, status, items, total', function () {",
									"    pm.expect(body).to.include.all.keys('orderId', 'status', 'items', 'total');",
									"});",
									"",
									"pm.test('Field types: orderId string, status string, items array, total number', function () {",
									"    pm.expect(body.orderId).to.be.a('string');",
									"    pm.expect(body.status).to.be.a('string');",
									"    pm.expect(body.items).to.be.an('array').that.is.not.empty;",
									"    pm.expect(body.total).to.be.a('number');",
									"});",
									"",
									"pm.test('Each item has an integer productId and a positive integer quantity', function () {",
									"    body.items.forEach(function (item, i) {",
									"        pm.expect(Number.isInteger(item.productId), 'items[' + i + '].productId is an integer').to.be.true;",
									"        pm.expect(Number.isInteger(item.quantity), 'items[' + i + '].quantity is an integer').to.be.true;",
									"        pm.expect(item.quantity, 'items[' + i + '].quantity').to.be.at.least(1);",
									"    });",
									"});",
									"",
									"pm.test('Returned orderId matches the one requested in the URL', function () {",
									"    pm.expect(body.orderId).to.equal(requestedId);",
									"});",
									"",
									"pm.test('total equals the sum of price x quantity for the returned items', function () {",
									"    const expectedCents = body.items.reduce(function (sum, item) {",
									"        const product = catalogue.find(function (p) { return p.id === item.productId; });",
									"        pm.expect(product, 'productId ' + item.productId + ' exists in the catalogue').to.exist;",
									"        return sum + Math.round(product.price * 100) * item.quantity;",
									"    }, 0);",
									"    pm.expect(Math.round(body.total * 100)).to.equal(expectedCents);",
									"});",
									"",
									"// Only meaningful when POST /orders ran earlier in the same run.",
									"(created ? pm.test : pm.test.skip)('Order matches what POST /orders created (orderId, status, total, items)', function () {",
									"    const c = JSON.parse(created);",
									"    pm.expect(body.orderId).to.equal(c.orderId);",
									"    pm.expect(body.status).to.equal(c.status);",
									"    pm.expect(body.total).to.equal(c.total);",
									"    pm.expect(body.items).to.deep.equal(c.items);",
									"});"
								]
							}
