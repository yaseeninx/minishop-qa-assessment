		{
			"name": "Orders",
			"item": [
				{
					"name": "POST /orders - create order (201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"const sent = JSON.parse(pm.request.body.raw);",
									"const catalogue = JSON.parse(pm.collectionVariables.get('expectedCatalogue'));",
									"",
									"pm.test('Status is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Required fields present: orderId, status, total, estimatedDelivery', function () {",
									"    pm.expect(body).to.include.all.keys('orderId', 'status', 'total', 'estimatedDelivery');",
									"});",
									"",
									"pm.test('orderId is a string in the ORD-<number> format', function () {",
									"    pm.expect(body.orderId).to.be.a('string');",
									"    pm.expect(body.orderId).to.match(/^ORD-\\d+$/);",
									"});",
									"",
									"pm.test('status is the string \"confirmed\"', function () {",
									"    pm.expect(body.status).to.be.a('string');",
									"    pm.expect(body.status).to.equal('confirmed');",
									"});",
									"",
									"pm.test('total is a positive number with at most 2 decimal places', function () {",
									"    pm.expect(body.total).to.be.a('number').and.to.be.above(0);",
									"    pm.expect(Math.round(body.total * 100) / 100).to.equal(body.total);",
									"});",
									"",
									"pm.test('total equals the sum of price x quantity for the ordered items', function () {",
									"    // Calculated in integer cents so floating-point error cannot hide a wrong total.",
									"    const expectedCents = sent.items.reduce(function (sum, item) {",
									"        const product = catalogue.find(function (p) { return p.id === item.productId; });",
									"        pm.expect(product, 'productId ' + item.productId + ' exists in the catalogue').to.exist;",
									"        return sum + Math.round(product.price * 100) * item.quantity;",
									"    }, 0);",
									"    pm.expect(Math.round(body.total * 100)).to.equal(expectedCents);",
									"});",
									"",
									"pm.test('estimatedDelivery is a real calendar date in YYYY-MM-DD format', function () {",
									"    pm.expect(body.estimatedDelivery).to.be.a('string').and.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
									"    const parsed = new Date(body.estimatedDelivery + 'T00:00:00Z');",
									"    pm.expect(isNaN(parsed.getTime()), 'date parses').to.be.false;",
									"    pm.expect(parsed.toISOString().slice(0, 10), 'no rollover such as 2026-02-30').to.equal(body.estimatedDelivery);",
									"});",
									"",
									"pm.test('Success response carries no error property', function () {",
									"    pm.expect(body).to.not.have.property('error');",
									"});",
									"",
									"// Hand-off to GET /orders/{orderId}",
									"pm.collectionVariables.set('orderId', body.orderId);",
									"pm.collectionVariables.set('createdOrder', JSON.stringify({ orderId: body.orderId, status: body.status, total: body.total, items: sent.items }));"
								]
							}
						}
					],
