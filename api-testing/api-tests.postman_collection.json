	"item": [
		{
			"name": "Products",
			"item": [
				{
					"name": "GET /products - list products (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"const expectedCatalogue = JSON.parse(pm.collectionVariables.get('expectedCatalogue'));",
									"",
									"pm.test('Status is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Body is a non-empty array', function () {",
									"    pm.expect(body).to.be.an('array').that.is.not.empty;",
									"});",
									"",
									"pm.test('Every product has the required fields: id, name, price, inStock', function () {",
									"    body.forEach(function (p, i) {",
									"        pm.expect(p, 'product[' + i + ']').to.include.all.keys('id', 'name', 'price', 'inStock');",
									"    });",
									"});",
									"",
									"pm.test('Field types: id integer, name non-empty string, price number, inStock boolean', function () {",
									"    body.forEach(function (p) {",
									"        pm.expect(Number.isInteger(p.id), 'id of ' + p.name + ' is an integer').to.be.true;",
									"        pm.expect(p.name, 'name of product ' + p.id).to.be.a('string').that.is.not.empty;",
									"        pm.expect(p.price, 'price of ' + p.name).to.be.a('number');",
									"        pm.expect(p.inStock, 'inStock of ' + p.name).to.be.a('boolean');",
									"    });",
									"});",
									"",
									"pm.test('Body matches the product JSON schema', function () {",
									"    pm.response.to.have.jsonSchema({",
									"        type: 'array',",
									"        minItems: 1,",
									"        items: {",
									"            type: 'object',",
									"            required: ['id', 'name', 'price', 'inStock'],",
									"            properties: {",
									"                id: { type: 'integer', minimum: 1 },",
									"                name: { type: 'string', minLength: 1 },",
									"                price: { type: 'number', minimum: 0 },",
									"                inStock: { type: 'boolean' }",
									"            }",
									"        }",
									"    });",
									"});",
									"",
									"pm.test('Product ids are unique', function () {",
									"    const ids = body.map(function (p) { return p.id; });",
									"    pm.expect(new Set(ids).size).to.equal(ids.length);",
									"});",
									"",
									"pm.test('Prices are positive with at most 2 decimal places', function () {",
									"    body.forEach(function (p) {",
									"        pm.expect(p.price, p.name).to.be.above(0);",
									"        pm.expect(Math.round(p.price * 100) / 100, p.name + ' has more than 2 decimals').to.equal(p.price);",
									"    });",
									"});",
									"",
									"pm.test('Catalogue matches the contract / MiniShop v1 UI (names, prices, stock)', function () {",
									"    pm.expect(body).to.deep.equal(expectedCatalogue);",
									"});"
								]
							}
						}
					],
